# peak RSS (메모리, bytes):
  grep 'maximum resident set size' logs/prove_*.time

# 전체 wall time per run:
  grep 'total_wall_ms' logs/prove_*.log

# 실패한 run 확인:
  grep '\[FAIL\]' logs/master_*.log
